.bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1px solid #eee;
  display: flex;
  z-index: 999;
}
.item {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  color: #888888; gap: 4rpx;
}
.item.on { color: #e45d43; }
.txt { font-size: 20rpx; }
.ico {
  width: 44rpx; height: 44rpx; position: relative;
  box-sizing: border-box;
}
.ico.home {
  border: 3rpx solid currentColor; border-top: none;
  width: 34rpx; height: 26rpx; margin-top: 14rpx;
}
.ico.home::before {
  content: ""; position: absolute; left: -8rpx; top: -16rpx;
  width: 28rpx; height: 28rpx;
  border-top: 3rpx solid currentColor; border-right: 3rpx solid currentColor;
  transform: rotate(-45deg); transform-origin: center;
}
.ico.category {
  width: 36rpx; height: 36rpx;
  background:
    linear-gradient(currentColor, currentColor) 0 0 / 14rpx 14rpx no-repeat,
    linear-gradient(currentColor, currentColor) 22rpx 0 / 14rpx 14rpx no-repeat,
    linear-gradient(currentColor, currentColor) 0 22rpx / 14rpx 14rpx no-repeat,
    linear-gradient(currentColor, currentColor) 22rpx 22rpx / 14rpx 14rpx no-repeat;
  opacity: 0.95;
}
.item.on .ico.category { opacity: 1; }
.ico.quote {
  width: 34rpx; height: 38rpx;
  border: 3rpx solid currentColor; border-radius: 6rpx;
}
.ico.quote::before {
  content: ""; position: absolute; left: 6rpx; top: 10rpx;
  width: 16rpx; height: 3rpx; background: currentColor;
  box-shadow: 0 8rpx 0 currentColor, 0 16rpx 0 currentColor;
}
.ico.mine {
  width: 40rpx; height: 40rpx;
}
.ico.mine::before {
  content: ""; position: absolute; left: 10rpx; top: 2rpx;
  width: 16rpx; height: 16rpx; border: 3rpx solid currentColor; border-radius: 50%;
}
.ico.mine::after {
  content: ""; position: absolute; left: 4rpx; top: 22rpx;
  width: 28rpx; height: 14rpx;
  border: 3rpx solid currentColor; border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
}
