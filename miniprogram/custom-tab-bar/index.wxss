.bar {
  position: fixed; left: 0; right: 0; bottom: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1px solid #eee;
  display: flex;
  z-index: 999;
}
.item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #888; }
.item.on { color: #e45d43; }
.txt { font-size: 20rpx; margin-top: 4rpx; }
.ico { width: 48rpx; height: 48rpx; position: relative; }
/* home */
.ico.home::before {
  content: ""; position: absolute; left: 8rpx; top: 18rpx; right: 8rpx; bottom: 8rpx;
  border: 3rpx solid currentColor; border-top: none;
}
.ico.home::after {
  content: ""; position: absolute; left: 4rpx; top: 20rpx; width: 40rpx; height: 40rpx;
  border-top: 3rpx solid currentColor; transform: rotate(45deg); transform-origin: top left;
  box-sizing: border-box; border-right: 3rpx solid currentColor; background: transparent;
  width: 28rpx; height: 28rpx; left: 10rpx; top: 4rpx;
}
/* category grid */
.ico.category::before, .ico.category::after {
  content: ""; position: absolute; width: 16rpx; height: 16rpx;
  border: 3rpx solid currentColor; border-radius: 2rpx;
}
.ico.category::before { left: 6rpx; top: 6rpx; box-shadow: 20rpx 0 0 currentColor; }
.ico.category::after { left: 6rpx; top: 26rpx; box-shadow: 20rpx 0 0 currentColor; }
/* quote list */
.ico.quote::before {
  content: ""; position: absolute; left: 10rpx; top: 4rpx; right: 10rpx; bottom: 4rpx;
  border: 3rpx solid currentColor; border-radius: 4rpx;
}
.ico.quote::after {
  content: ""; position: absolute; left: 18rpx; top: 16rpx; width: 12rpx; height: 3rpx;
  background: currentColor; box-shadow: 0 10rpx 0 currentColor, 0 20rpx 0 currentColor;
}
/* mine person */
.ico.mine::before {
  content: ""; position: absolute; left: 14rpx; top: 4rpx; width: 20rpx; height: 20rpx;
  border: 3rpx solid currentColor; border-radius: 50%;
}
.ico.mine::after {
  content: ""; position: absolute; left: 8rpx; top: 28rpx; width: 32rpx; height: 16rpx;
  border: 3rpx solid currentColor; border-bottom: none; border-radius: 16rpx 16rpx 0 0;
}
