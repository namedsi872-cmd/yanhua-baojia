.page { min-height: 100vh; background: #f7f6f3; padding-bottom: 160rpx; }
.hero { height: 750rpx; background: #202326; }
.hero-img { width: 100%; height: 100%; }
.hero-ph {
  height: 100%; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(160deg, #1a1630, #2a1840);
}
.hero-emoji { font-size: 160rpx; }
.sheet {
  margin-top: -48rpx;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx 40rpx;
  position: relative;
  z-index: 2;
  min-height: 50vh;
}
.name { font-size: 40rpx; font-weight: 700; color: #202326; }
.spec-line { margin-top: 10rpx; color: #888; font-size: 26rpx; }
.price-row { margin-top: 16rpx; display: flex; align-items: baseline; gap: 16rpx; }
.price { color: #e45d43; font-size: 48rpx; font-weight: 800; }
.old { color: #bbb; font-size: 26rpx; text-decoration: line-through; }
.block { margin-top: 36rpx; }
.label { font-size: 28rpx; font-weight: 700; color: #202326; margin-bottom: 16rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 14rpx 28rpx; border-radius: 999rpx;
  background: #f7f6f3; color: #202326; font-size: 26rpx;
  border: 2rpx solid transparent;
}
.chip.on {
  background: #fff5f2; color: #e45d43;
  border-color: #e45d43; font-weight: 600;
}
.row-between { display: flex; align-items: center; justify-content: space-between; }
.row-between .label { margin-bottom: 0; }
.muted-line { color: #888; font-size: 24rpx; margin-top: 24rpx; }
.intro { color: #555; font-size: 26rpx; line-height: 1.7; }
.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
}
.add-btn {
  margin: 0; background: #e45d43; color: #fff;
  border-radius: 999rpx; font-size: 30rpx; font-weight: 700;
  padding: 22rpx 0;
}
.add-btn::after { border: none; }
