.back-btn {
  position: absolute; left: 24rpx; top: calc(24rpx + env(safe-area-inset-top));
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: rgba(0,0,0,0.35); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; line-height: 1; z-index: 5; font-weight: 300;
}
.page { min-height: 100vh; background: #f7f6f3; padding-bottom: 160rpx; }
.hero { position: relative; height: 700rpx; background: #111; margin-top: 0; }
.hero-img { width: 100%; height: 100%; display: block; }
.hero-ph {
  height: 100%; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(160deg, #1a1630, #2a1840);
}
.hero-emoji { font-size: 160rpx; }
.sheet {
  margin-top: -40rpx;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 36rpx 40rpx;
  position: relative;
  z-index: 2;
  min-height: 50vh;
}
.name { font-size: 44rpx; font-weight: 700; color: #202326; letter-spacing: 1rpx; }
.spec-line { margin-top: 12rpx; color: #888; font-size: 26rpx; }
.price-row { margin-top: 18rpx; display: flex; align-items: baseline; gap: 18rpx; }
.price { color: #e45d43; font-size: 52rpx; font-weight: 800; }
.old { color: #bbb; font-size: 28rpx; text-decoration: line-through; }
.divider { height: 1px; background: #f0f0f0; margin: 28rpx 0; }
.block { margin-top: 0; }
.label { font-size: 30rpx; font-weight: 700; color: #202326; margin-bottom: 20rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 18rpx; }
.chip {
  padding: 16rpx 36rpx; border-radius: 999rpx;
  background: #f7f6f3; color: #555; font-size: 28rpx;
  border: 2rpx solid transparent;
}
.chip.on {
  background: #fff5f2; color: #e45d43;
  border-color: #e45d43; font-weight: 600;
}
.row-between { display: flex; align-items: center; justify-content: space-between; }
.row-between .label { margin-bottom: 0; }
.muted-line { color: #888; font-size: 24rpx; margin-top: 28rpx; }
.intro { color: #555; font-size: 28rpx; line-height: 1.75; }
.footer {
  position: fixed; left: 0; right: 0; bottom: 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.04);
}
.add-btn {
  margin: 0; background: #e45d43; color: #fff;
  border-radius: 999rpx; font-size: 32rpx; font-weight: 700;
  padding: 24rpx 0;
}
.add-btn::after { border: none; }
