<view class="page page-with-tab">
  <view class="hero">
    <view class="hero-bg"></view>
    <view class="hero-row">
      <view class="avatar">游</view>
      <view class="hero-text">
        <view class="name">游客用户</view>
        <view class="sub">欢迎来到{{shop.name || '烟花小士多'}}</view>
      </view>
    </view>
  </view>

  <view class="menu">
    <view class="row" bindtap="goQuote">
      <view class="left"><text class="ico">🧾</text><text>我的报价单</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="row" bindtap="goOrders">
      <view class="left"><text class="ico">📋</text><text>我的订单</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="row" bindtap="goAddress">
      <view class="left"><text class="ico">📍</text><text>收货地址</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="row" bindtap="onCall">
      <view class="left"><text class="ico">☎</text><text>联系客服</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="row" bindtap="goAbout">
      <view class="left"><text class="ico">ℹ</text><text>关于我们</text></view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
