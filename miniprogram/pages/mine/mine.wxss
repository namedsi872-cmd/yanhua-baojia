.page { min-height: 100vh; background: #f7f6f3; }
.hero {
  position: relative; padding: 72rpx 36rpx 56rpx; overflow: hidden;
  background: linear-gradient(160deg, #efe8f2 0%, #f7f0ec 45%, #f7f6f3 100%);
}
.hero-deco {
  position: absolute; right: -20rpx; top: 10rpx;
  width: 280rpx; height: 280rpx; opacity: 0.9; pointer-events: none;
}
.hero-row {
  position: relative; z-index: 1;
  display: flex; align-items: center; gap: 24rpx;
}
.avatar {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: #d9d5d1;
}
.name { font-size: 36rpx; font-weight: 700; color: #202326; }
.sub { margin-top: 10rpx; font-size: 24rpx; color: #888; }
.menu {
  margin: 8rpx 24rpx 0; background: #fff; border-radius: 28rpx; overflow: hidden;
}
.row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 36rpx 28rpx; border-bottom: 1px solid #f3f3f3; font-size: 30rpx;
}
.row:last-child { border-bottom: none; }
.left { display: flex; align-items: center; gap: 20rpx; color: #202326; }
.ico { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.arrow { color: #ccc; font-size: 36rpx; }
