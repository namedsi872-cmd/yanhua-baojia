.page { padding: 24rpx; }
.hero {
  background: #202326;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.avatar {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #e45d43; display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700;
}
.name { font-size: 34rpx; font-weight: 700; }
.sub { margin-top: 8rpx; opacity: 0.8; font-size: 24rpx; }
.menu { background: #fff; border-radius: 28rpx; overflow: hidden; }
.row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 32rpx 28rpx; border-bottom: 1px solid #f0f0f0; font-size: 28rpx;
}
.row:last-child { border-bottom: none; }
.arrow { color: #ccc; font-size: 36rpx; }
