.page { min-height: 100vh; background: #f7f6f3; }
.hero {
  position: relative; padding: 64rpx 32rpx 48rpx; overflow: hidden;
}
.hero-bg {
  position: absolute; inset: 0;
  background:
    radial-gradient(circle at 80% 20%, rgba(228,93,67,0.18), transparent 40%),
    radial-gradient(circle at 20% 80%, rgba(255,180,120,0.15), transparent 45%),
    linear-gradient(180deg, #efe8e4 0%, #f7f6f3 100%);
}
.hero-row {
  position: relative; z-index: 1;
  display: flex; align-items: center; gap: 24rpx;
}
.avatar {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: #d9d5d1; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700;
}
.name { font-size: 34rpx; font-weight: 700; color: #202326; }
.sub { margin-top: 8rpx; font-size: 24rpx; color: #888; }
.menu {
  margin: 8rpx 24rpx 0; background: #fff; border-radius: 28rpx; overflow: hidden;
}
.row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 34rpx 28rpx; border-bottom: 1px solid #f3f3f3; font-size: 28rpx;
}
.row:last-child { border-bottom: none; }
.left { display: flex; align-items: center; gap: 16rpx; color: #202326; }
.ico { width: 40rpx; text-align: center; }
.arrow { color: #ccc; font-size: 36rpx; }
