<view class="page page-with-tab">
  <view class="hero">
    <image class="hero-img" src="{{config.bannerImage}}" mode="aspectFill" binderror="onBannerError" wx:if="{{config.bannerImage}}" />
    <view class="hero-fallback" wx:else></view>
    <view class="hero-mask"></view>
    <view class="hero-text">
      <view class="hero-title">{{config.brandName}}</view>
      <view class="hero-sub">{{config.brandSubtitle}}</view>
    </view>
  </view>

  <view class="search-wrap">
    <view class="search">
      <image class="search-ico" src="{{searchIcon}}" mode="aspectFit" />
      <input class="search-input" placeholder="{{config.searchPlaceholder}}" value="{{keyword}}" bindinput="onKeyword" bindconfirm="onSearch" confirm-type="search" />
    </view>
  </view>

  <view class="panel">
    <view class="section">
      <view class="section-head">
        <text class="section-title">热门分类</text>
        <text class="section-more" bindtap="goCategory">全部 ›</text>
      </view>
      <view class="cat-grid">
        <view class="cat-tile" wx:for="{{config.hotCategories}}" wx:key="id" data-id="{{item.id}}" bindtap="onHotCat">
          <view class="cat-ico-wrap">
            <image class="cat-ico" src="{{item.iconSrc}}" mode="aspectFit" />
          </view>
          <text class="cat-name">{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-head">
        <text class="section-title">精选推荐</text>
        <text class="section-more">更多 ›</text>
      </view>
      <view class="feat-card" wx:for="{{config.hotProducts}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenProduct">
        <image class="feat-thumb" src="{{item.image || item.featImage}}" mode="aspectFill" wx:if="{{item.image || item.featImage}}" />
        <view class="feat-thumb feat-ph" wx:else><text>{{item.emoji || '🎆'}}</text></view>
        <view class="feat-info">
          <view class="feat-name">{{item.name}}</view>
          <view class="feat-spec">{{item.specLine}}</view>
          <view class="feat-row">
            <text class="feat-price">¥{{item.priceText}}</text>
            <view class="feat-add" catchtap="onAdd" data-id="{{item.id}}">＋</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
