.page { padding: 24rpx 24rpx 48rpx; }
.brand {
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #202326;
  margin: 8rpx 0 20rpx;
  letter-spacing: 4rpx;
}
.banner-wrap {
  border-radius: 28rpx;
  overflow: hidden;
  background: #202326;
  height: 280rpx;
}
.banner { width: 100%; height: 280rpx; display: block; }
.search-wrap { margin: 24rpx 0; }
.search {
  background: #ffffff;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
}
.section { margin-top: 12rpx; }
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #202326;
  margin: 16rpx 0 16rpx;
}
.hot-cats { white-space: nowrap; height: 140rpx; }
.hot-cat {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  margin-right: 12rpx;
}
.hot-cat-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}
.hot-cat-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #202326;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.empty { text-align: center; color: #888; padding: 48rpx; }
.banner-fallback {
  width: 100%;
  height: 280rpx;
  background: #202326;
  position: relative;
  overflow: hidden;
}
.spark {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e45d43;
  box-shadow: 0 0 0 12rpx rgba(228,93,67,0.15), 0 0 40rpx rgba(228,93,67,0.5);
}
.spark::before, .spark::after {
  content: "";
  position: absolute;
  left: 50%; top: 50%;
  width: 2rpx; height: 48rpx;
  background: #ffb48a;
  transform: translate(-50%, -50%);
}
.spark::after { transform: translate(-50%, -50%) rotate(90deg); }
.s1 { left: 18%; top: 36%; }
.s2 { left: 48%; top: 28%; background: #ffc9a8; }
.s3 { left: 72%; top: 48%; }
.s4 { left: 36%; top: 62%; background: #ffc9a8; }
