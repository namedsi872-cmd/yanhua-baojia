.page { background: #f7f6f3; min-height: 100vh; }
.hero { position: relative; height: 520rpx; overflow: hidden; background: #0b1020; }
.hero-img, .hero-fallback { width: 100%; height: 520rpx; display: block; }
.hero-fallback {
  background: radial-gradient(circle at 30% 40%, rgba(228,93,67,0.55), transparent 42%),
    radial-gradient(circle at 70% 30%, rgba(255,180,120,0.45), transparent 40%),
    linear-gradient(180deg, #0b1020 0%, #1a1630 55%, #2a1840 100%);
}
.hero-mask {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.05) 40%, rgba(0,0,0,0.4) 100%);
}
.hero-text { position: absolute; left: 40rpx; top: 120rpx; color: #fff; z-index: 2; }
.hero-title { font-size: 52rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-sub { margin-top: 14rpx; font-size: 26rpx; opacity: 0.92; font-weight: 400; }

.search-wrap { margin: -48rpx 32rpx 0; position: relative; z-index: 3; }
.search {
  background: #fff; border-radius: 999rpx; padding: 20rpx 28rpx;
  display: flex; align-items: center; gap: 14rpx;
  box-shadow: 0 10rpx 28rpx rgba(32,35,38,0.10);
}
.search-ico { width: 32rpx; height: 32rpx; opacity: 0.45; flex-shrink: 0; }
.search-input { flex: 1; font-size: 28rpx; color: #202326; }

.panel {
  margin-top: 24rpx; background: #fff;
  border-radius: 36rpx 36rpx 0 0; padding: 8rpx 0 40rpx; min-height: 60vh;
}
.section { padding: 28rpx 32rpx 8rpx; }
.section-head {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 22rpx;
}
.section-title { font-size: 34rpx; font-weight: 700; color: #202326; }
.section-more { font-size: 24rpx; color: #999; }

.cat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18rpx 12rpx; }
.cat-tile { display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.cat-ico-wrap {
  width: 104rpx; height: 104rpx; border-radius: 28rpx;
  background: linear-gradient(180deg, #fff5f0 0%, #f8ebe6 100%);
  display: flex; align-items: center; justify-content: center;
}
.cat-ico { width: 56rpx; height: 56rpx; }
.cat-name {
  font-size: 22rpx; color: #333; text-align: center;
  max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}

.feat-card {
  display: flex; background: #fff; border-radius: 24rpx; overflow: hidden;
  margin-bottom: 20rpx; box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.04);
  border: 1px solid #f2f2f2; min-height: 220rpx;
}
.feat-thumb {
  width: 45%; height: 220rpx; flex-shrink: 0; background: #111;
  border-radius: 24rpx 0 0 24rpx;
}
.feat-ph { display: flex; align-items: center; justify-content: center; font-size: 64rpx; background: #efece8; }
.feat-info { flex: 1; min-width: 0; padding: 24rpx 22rpx; display: flex; flex-direction: column; }
.feat-name { font-size: 32rpx; font-weight: 700; color: #202326; }
.feat-spec { margin-top: 10rpx; font-size: 24rpx; color: #888; }
.feat-row { margin-top: auto; display: flex; align-items: center; justify-content: space-between; }
.feat-price { color: #e45d43; font-size: 36rpx; font-weight: 800; }
.feat-add {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: #e45d43; color: #fff;
  display: flex; align-items: center; justify-content: center; font-size: 36rpx; line-height: 1; font-weight: 500;
}
