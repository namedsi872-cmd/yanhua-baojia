<view class="page">
  <view class="search-bar">
    <input class="search" placeholder="搜索商品" value="{{keyword}}" bindinput="onKeyword" bindconfirm="onSearch" confirm-type="search" />
  </view>
  <view class="body">
    <scroll-view scroll-y class="sidebar">
      <view
        wx:for="{{categories}}"
        wx:key="id"
        class="cat {{item.id === categoryId ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelectCat"
      >
        <text>{{item.name}}</text>
        <text class="count">{{item.count}}</text>
      </view>
    </scroll-view>
    <view class="main">
      <view class="main-head">
        <view class="cat-title">{{currentName}}</view>
        <view class="sorts">
          <text class="sort {{sort==='default'?'on':''}}" data-sort="default" bindtap="onSort">默认</text>
          <text class="sort {{sort==='price_asc'?'on':''}}" data-sort="price_asc" bindtap="onSort">价格</text>
          <text class="sort {{sort==='sales_desc'?'on':''}}" data-sort="sales_desc" bindtap="onSort">销量</text>
        </view>
      </view>
      <scroll-view scroll-y class="list">
        <block wx:if="{{products.length}}">
          <product-card wx:for="{{products}}" wx:key="id" product="{{item}}" />
        </block>
        <view wx:else class="empty">该分类暂无商品</view>
      </scroll-view>
    </view>
  </view>
</view>
