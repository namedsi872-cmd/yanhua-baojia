.page { height: 100vh; display: flex; flex-direction: column; background: #fff; }
.search-bar { padding: 12rpx 24rpx 16rpx; background: #fff; flex-shrink: 0; }
.search {
  background: #f7f6f3; border-radius: 999rpx; padding: 14rpx 24rpx;
  display: flex; align-items: center; gap: 10rpx;
}
.search-ico { font-size: 24rpx; opacity: 0.45; }
.search-input { flex: 1; font-size: 26rpx; }
.body { flex: 1; display: flex; min-height: 0; }
.sidebar {
  width: 176rpx; flex-shrink: 0; background: #f5f5f5; height: 100%;
}
.cat {
  padding: 32rpx 16rpx; font-size: 26rpx; color: #666; text-align: center;
  position: relative; line-height: 1.35;
}
.cat.active {
  background: #fff; color: #e45d43; font-weight: 700;
}
.cat.active::before {
  content: ""; position: absolute; left: 0; top: 28rpx; bottom: 28rpx;
  width: 6rpx; background: #e45d43; border-radius: 0 6rpx 6rpx 0;
}
.main { flex: 1; min-width: 0; display: flex; flex-direction: column; background: #fff; }
.main-head { padding: 16rpx 20rpx 8rpx; flex-shrink: 0; }
.cat-title { font-size: 30rpx; font-weight: 700; color: #202326; }
.sorts { margin-top: 12rpx; display: flex; gap: 24rpx; }
.sort { font-size: 24rpx; color: #888; }
.sort.on { color: #e45d43; font-weight: 600; }
.list { flex: 1; height: 0; padding: 8rpx 16rpx 24rpx; box-sizing: border-box; }
.empty { text-align: center; color: #888; padding: 80rpx 20rpx; }
