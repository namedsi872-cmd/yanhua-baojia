.page { height: 100vh; display: flex; flex-direction: column; background: #f7f6f3; }
.search-bar { padding: 16rpx 24rpx; background: #fff; }
.search {
  background: #f7f6f3;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  font-size: 26rpx;
}
.body { flex: 1; display: flex; min-height: 0; }
.sidebar {
  width: 180rpx;
  background: #fafafa;
  height: 100%;
}
.cat {
  padding: 28rpx 16rpx;
  font-size: 24rpx;
  color: #555;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.cat.active {
  background: #fff;
  color: #e45d43;
  font-weight: 600;
}
.cat.active::before {
  content: "";
  position: absolute;
  left: 0; top: 22rpx; bottom: 22rpx;
  width: 6rpx;
  background: #e45d43;
  border-radius: 0 6rpx 6rpx 0;
}
.count { font-size: 20rpx; color: #888; font-weight: 400; }
.main { flex: 1; display: flex; flex-direction: column; min-width: 0; background: #f7f6f3; }
.main-head { padding: 16rpx 20rpx 8rpx; }
.cat-title { font-size: 30rpx; font-weight: 700; color: #202326; }
.sorts { margin-top: 12rpx; display: flex; gap: 20rpx; }
.sort { font-size: 24rpx; color: #888; }
.sort.on { color: #e45d43; font-weight: 600; }
.list { flex: 1; height: 0; padding: 8rpx 16rpx 24rpx; box-sizing: border-box; }
.empty { text-align: center; color: #888; padding: 80rpx 20rpx; }
