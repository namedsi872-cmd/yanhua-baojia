.stepper {
  display: inline-flex;
  align-items: center;
  border: 1px solid #e5e5e5;
  border-radius: 12rpx;
  overflow: hidden;
}
.btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #f7f6f3;
  font-size: 32rpx;
  color: #202326;
}
.btn.disabled { color: #cccccc; }
.num {
  min-width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}
