.stepper {
  display: inline-flex;
  align-items: center;
  background: #f3f3f3;
  border-radius: 999rpx;
  overflow: hidden;
  height: 56rpx;
}
.btn {
  width: 56rpx; height: 56rpx; line-height: 56rpx;
  text-align: center; font-size: 30rpx; color: #666;
}
.btn.plus { color: #e45d43; font-weight: 700; }
.btn.disabled { color: #ccc; }
.num {
  min-width: 48rpx; text-align: center;
  font-size: 28rpx; font-weight: 600; color: #202326;
}
